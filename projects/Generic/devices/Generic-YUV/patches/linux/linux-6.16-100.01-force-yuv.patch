diff -Naur linux-6.16.12/drivers/gpu/drm/i915/display/intel_hdmi.c linux-6.16.12.patch/drivers/gpu/drm/i915/display/intel_hdmi.c
--- linux-6.16.12/drivers/gpu/drm/i915/display/intel_hdmi.c	2025-10-12 13:01:05.000000000 +0200
